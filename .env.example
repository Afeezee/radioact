# RadioAct — all optional. Missing keys fall back to a deterministic demo path.
# When deploying to Vercel, set these in the Vercel dashboard under Settings -> Environment Variables.

# Preferred vision provider: Anthropic Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Fallback vision provider: Groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Ontomorph DTP platform (twins, HOLON). Get an api key + a grant token from
# https://ontomorph.com — for local dev, a sandbox `dtp_test_...` key + a
# demo grant minted via dtp.sandbox.grants() also works.
DTP_API_KEY=
DTP_GRANT_TOKEN=
HOLON_API_URL=
HOLON_API_KEY=

# Neon Postgres. Optional — without it, the app uses an in-memory store that
# resets on server restart.
DATABASE_URL=

# Clerk auth. Optional — without both, the app uses a built-in demo session.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
